# Documentation template only. Run scripts/start-local.ps1 or start-local.sh to
# create private .env.local-docker with three independently random credentials.
# Local Compose fixes the origin to http://127.0.0.1:${APP_PORT} and binds loopback.
APP_PORT=5488
POSTGRES_PASSWORD=generated-by-start-local
BETTER_AUTH_SECRET=generated-by-start-local
CREDENTIAL_ENCRYPTION_KEYS=local:generated-by-start-local
LOCAL_MEDIA_QUOTA_BYTES=1073741824
# Minimum free space before a local upload; 0 disables the reserve check.
LOCAL_MEDIA_MIN_FREE_BYTES=268435456
AI_IMAGE_TIMEOUT_MS=600000
