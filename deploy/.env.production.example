# Copy this template outside the Git checkout (for example /opt/prompt-notebook/.env).
# Replace every placeholder before deployment. Do not commit the populated file.
# Use your own public HTTPS origin; no author-owned domain or WordPress is needed.
APP_URL=https://prompts.example.com
# Server mode keeps production email verification; local mode is loopback-only.
APP_DEPLOYMENT_MODE=server
APP_PORT=5488
COMPOSE_PROJECT_NAME=prompt-notebook
APP_IMAGE=prompt-notebook
IMAGE_TAG=latest

AI_CONNECTION_TIMEOUT_MS=10000
AI_TEXT_TIMEOUT_MS=60000
AI_REVERSE_PROMPT_TIMEOUT_MS=120000
AI_IMAGE_TIMEOUT_MS=600000
# Per-user quota for the optional instance-local image storage (default 1 GiB).
# Docker Compose mounts a persistent shared web/worker volume at /app/data/media.
LOCAL_MEDIA_QUOTA_BYTES=1073741824
# Disk free-space reserve shared by all local uploads: 256 MiB; 0 disables it.
LOCAL_MEDIA_MIN_FREE_BYTES=268435456

# Generate a URL-safe database password, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Generate a separate authentication secret, for example: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Must be overwritten by the trusted reverse proxy, never forwarded unchanged.
BETTER_AUTH_IP_ADDRESS_HEADERS=x-real-ip
# Generate a separate 32-byte key: openssl rand -hex 32
# Keep this key ring backed up separately; losing it prevents decrypting saved keys.
CREDENTIAL_ENCRYPTION_KEYS=primary:replace-with-a-32-byte-hex-or-base64url-key
CREDENTIAL_ACTIVE_KEY_ID=primary

# REQUIRED for production signup: production requires email verification.
# Without working SMTP, the app may be healthy but users cannot finish signup/login.
# Set your mail provider's host, sender and any required authentication values.
# Port 465 enables implicit TLS; 587 uses the provider's STARTTLS support.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Prompt Notebook <no-reply@example.com>
