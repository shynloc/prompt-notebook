server {
    listen 80;
    server_name prompts.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name prompts.example.com;

    ssl_certificate /etc/letsencrypt/live/prompts.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/prompts.example.com/privkey.pem;

    # One ImageHub request may contain four 10 MB reference images plus multipart overhead.
    client_max_body_size 45m;
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:5488;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Better Auth trusts this single-value header. If a CDN sits in front of
        # Nginx, configure set_real_ip_from + real_ip_header for that CDN first.
        # This assignment must overwrite any client-supplied X-Real-IP value.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
