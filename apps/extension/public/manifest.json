{
  "manifest_version": 3,
  "name": "Prompt Notebook 提示词笔记本",
  "description": "选择网页中的提示词，编辑后保存到你的私人提示词笔记本。",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage", "identity"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "保存到提示词笔记本",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "save-prompt": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "保存当前选中的提示词"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
