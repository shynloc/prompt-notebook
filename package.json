{
  "name": "prompt-notebook",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shynloc/prompt-notebook.git"
  },
  "homepage": "https://github.com/shynloc/prompt-notebook#readme",
  "bugs": {
    "url": "https://github.com/shynloc/prompt-notebook/issues"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild scripts/generation-worker.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/generation-worker.mjs",
    "start": "next start",
    "worker:generation": "node dist/generation-worker.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "extension:dev": "npm run dev -w @prompt-notebook/extension",
    "extension:build": "npm run build -w @prompt-notebook/extension",
    "extension:test": "npm run test -w @prompt-notebook/extension",
    "extension:zip": "npm run zip -w @prompt-notebook/extension",
    "perf:seed": "node scripts/seed-performance.mjs",
    "perf:benchmark": "node scripts/benchmark-notes.mjs",
    "release:check": "node scripts/check-release-config.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "better-auth": "^1.6.23",
    "bullmq": "^5.80.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.17",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.12",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "postcss": "8.5.25",
    "sharp": "$sharp"
  }
}
